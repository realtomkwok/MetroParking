    "faq.1.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app refreshes automatically in the foreground roughly every 60 seconds. \nIf data is stale, you'll see a breathing animation indicating a refresh is in progress. The timestamp shown reflects when the facility last reported its occupancy to TfNSW."
          }
        }
      }
    },
    "faq.1.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How up-to-date is the parking data?"
          }
        }
      }
    },
    "faq.2.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only if you grant permission. Location is used to sort facilities by distance and to calculate driving ETAs. It is never sent to any server and you can disable the location service via Settings anytime."
          }
        }
      }
    },
    "faq.2.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does the app use my location?"
          }
        }
      }
    },
    "faq.3.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetroParking displays exactly what the TfNSW API reports. Occasional discrepancies can happen if a facility's sensors are offline or delayed.\nTry refresh again and if problem persists, please contact the developer."
          }
        }
      }
    },
    "faq.3.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why does the data sometimes seem wrong?"
          }
        }
      }
    },
    "faq.carpark.hours.body" : {
      "comment" : "The body text for the FAQ question about the hours of operation of the car park.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Park&Ride car parks operates 24 hours a day, 7 days a week except Dee Why.\n\nPark&Ride Dee Why is open from 5.30am to midnight Monday to Saturday, 6.30am to midnight Sundays and public holidays."
          }
        }
      }
    },
