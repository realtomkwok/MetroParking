    "location.alert.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll get distance, estimated travel times to a carpark from your current location, and improved search results when it is turned on for MetroParking."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用定位服务后，MetroParking将可计算从您所在位置到指定停车场的距离、预估行程时间以及提供优化的搜索结果。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，MetroParking 可從您的目前位置計算前往停車場的距離、估計駕車時間，並改善搜尋結果。"
          }
        }
      }
    },
    "location.alert.headline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetroParking works best with Location Services turned on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配合定位服务，MetroParking会更好用。"
