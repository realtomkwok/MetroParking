    "faq.1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app refreshes automatically in the foreground roughly every 60 seconds. \n\nIf data is stale, you'll see a breathing animation indicating a refresh is in progress. The timestamp shown reflects when it is last updated."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用会在前台每隔约 60 秒自动刷新。\n\n如果数据过时，您会看到呼吸动画，表示正在刷新。显示的时间戳为最后刷新的时间"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App會在打開的時候每隔約 60 秒自動更新。\n\n如果資料過時，你會見到呼吸動畫，表示正在更新。顯示的時間為最後更新的時間。"
          }
        }
      }
    },
    "faq.1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How up-to-date is the parking data?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停车场资料多久更新一次？"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停車場資料幾時更新？"
          }
        }
      }
    },
    "faq.2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only if you grant permission. Location is used to sort facilities by distance and to calculate driving ETAs. It is never sent to any server and you can disable the location service via Settings anytime."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在你授予权限的情况下，位置才会用于按距离排序停车场及计算驾车预计到达时间。数据绝不会传输至任何服务器，您可以随时通过\"设置\"关闭定位服务。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你授予權限的情況下，你的位置才會用於按距離排序停車場，及計算駕車預計到達時間。資料絕不會傳送至任何伺服器，您可以隨時透過「設定」停用定位服務。"
          }
        }
      }
    },
    "faq.2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does the app use my location?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用会使用我的位置信息吗？"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 會使用我的位置嗎？"
          }
        }
      }
    },
    "faq.3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetroParking displays exactly what the TfNSW API reports. Occasional discrepancies can happen if a facility's sensors are offline or delayed.\n\nTry refresh again and if problem persists, please contact the developer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetroParking 显示的内容与 TfNSW API 报告完全一致。如果停车场的传感器离线或延迟，偶尔可能出现数据差异。\n\n请重试，如问题持续，请联系开发者。\n"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetroParking 顯示的內容與 TfNSW API 報告完全一致。如果停車場的感應器離線或延遲，偶爾可能出現資料差異。\n\n請再試一次，如果問題持續，請聯絡開發者。"
          }
        }
      }
    },
    "faq.3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why does the data sometimes seem wrong?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为什么停车场数据有出入？"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為什麼停車場資訊有出入？"
          }
        }
      }
    },
    "faq.carpark.hours.body" : {
      "comment" : "The body text for the FAQ question about the hours of operation of the car park.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Park&Ride car parks operates 24 hours a day, 7 days a week except Dee Why.\n\nPark&Ride Dee Why is open from 5.30am to midnight Monday to Saturday, 6.30am to midnight Sundays and public holidays."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除Dee Why外，所有Park&Ride停车场每周七天、每天24小时开放。\n\nPark&Ride Dee Why的开放时间为周一至周六上午 5:30 至午夜，周日上午 6:30 至午夜，法定节假日同上。\n"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有Park&Ride停車場每週七天、每天 24 小時開放，惟Dee Why除外。\n\nPark&Ride Dee Why的開放時間為星期一至六上午 5:30 至午夜，星期日上午 6:30 至午夜，公眾假期亦同。"
          }
        }
      }
    },
